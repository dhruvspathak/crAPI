    {
      "name": "Challenge 1 & 2 - BOLA (Vehicle & Mechanic Reports)",
      "item": [
        {
          "name": "1.1 - Get Your Vehicles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_a_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8888/identity/api/v2/vehicle/vehicles",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["identity", "api", "v2", "vehicle", "vehicles"]
            }
          }
        },
        {
          "name": "1.2 - Access Other User's Vehicle (BOLA)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_b_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8888/identity/api/v2/vehicle/{{other_user_vehicle_guid}}/location",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["identity", "api", "v2", "vehicle", "{{other_user_vehicle_guid}}", "location"]
            }
          }
        },
        {
          "name": "2.1 - Contact Mechanic (Generate Report)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_a_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"mechanic_code\": \"MECH_JOHN_08\", \"vin\": \"{{user_a_vin}}\", \"problem_details\": \"Engine noise\", \"mechanic_api\": \"http://localhost:8888/workshop/api/mechanic/receive_report\", \"repeat_request_if_failed\": false, \"number_of_repeats\": 1}"
            },
            "url": {
              "raw": "http://localhost:8888/workshop/api/merchant/contact_mechanic",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["workshop", "api", "merchant", "contact_mechanic"]
            }
          }
        },
        {
          "name": "2.2 - Access Other's Mechanic Report (BOLA)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_b_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8888/workshop/api/mechanic/mechanic_report?report_id={{other_user_report_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["workshop", "api", "mechanic", "mechanic_report"],
              "query": [
                {
                  "key": "report_id",
                  "value": "{{other_user_report_id}}"
                }
              ]
            }
          }
        }
      ]
    },
