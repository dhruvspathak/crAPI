# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=crapi
DB_USER=admin
DB_PASSWORD=your_secure_password_here

# Server Configuration
SERVER_PORT=8080
LOG_LEVEL=INFO

# JWT Configuration
JWT_EXPIRATION=604800000
JWKS=your_jwks_json_here

# SMTP Configuration
SMTP_FROM=no-reply@example.com
SMTP_AUTH=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_EMAIL=no-reply@example.com
SMTP_PASS=your_smtp_password_here
SMTP_STARTTLS=false

# Mailhog Configuration
MAILHOG_HOST=localhost
MAILHOG_PORT=1025
MAILHOG_DOMAIN=localhost

# API Gateway Configuration
API_GATEWAY_URL=https://api.mypremiumdealership.com
API_GATEWAY_USERNAME=vendorcrapi
API_GATEWAY_PASSWORD=your_secure_password_here

# TLS Configuration
TLS_ENABLED=false
TLS_KEYSTORE_TYPE=PKCS12
TLS_KEYSTORE=/path/to/keystore.p12
TLS_KEYSTORE_PASSWORD=your_keystore_password_here
TLS_KEY_PASSWORD=your_key_password_here
TLS_KEY_ALIAS=your_key_alias

# Application Configuration
ENABLE_SHELL_INJECTION=false
